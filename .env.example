AI_PROVIDER=deepseek

# ---------- 上传空间治理 ----------
# 以下三个值使用字节数，默认分别为 50 MB、200 MB、2 GB。
LOGINSIGHT_MAX_FILE_BYTES=52428800
LOGINSIGHT_MAX_ANALYSIS_BYTES=209715200
LOGINSIGHT_MAX_STORAGE_BYTES=2147483648

# 通用兼容入口：AI_PROVIDER=openai_compatible 时使用这三个变量。
# 也可用它们覆盖下方厂商预设的同名配置。
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_JSON_RESPONSE_FORMAT=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=ollama

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ---------- AI 研判时长与深度 ----------
# 研判以结论准确为先，不追求快速返回：默认值已给足余量，
# 慢模型 / 长上下文日志可继续调大，不需要为了"快一点"牺牲结论质量。
AI_TIMEOUT_SECONDS=300        # 单次模型请求超时（秒）；超时提示会给出已等待时长。留空时大日志自动翻倍
AI_MAX_TOOL_ROUNDS=10         # 模型可追加的只读工具调用轮次上限；留空时按规模自适应（无事件的日志只给 1 轮）
AI_MAX_OUTPUT_TOKENS=4096     # Anthropic 路径的输出上限（结构化研判字段较多，过小会被截断）
AI_MAX_RETRIES=2              # 传输层失败（限流 / 5xx / 断网 / 响应体损坏）的自动重试次数；鉴权与超时不重试
AI_CONTEXT_MAX_BYTES=2000000  # 发给模型的上下文 JSON 硬上限（含 tool_results）；无法容纳时拒绝发送

# ---------- AI Token 成本控制（v1.1 新增/加强）----------
# 上下文构成与多轮重发的成本模型见 docs/ai-token-cost.md，
# 效果基准：cd backend && .venv\Scripts\python.exe scripts\bench_ai_context.py
#
# 已内置的默认行为（无需配置，留空即生效）：
#   · 工具结果指针化  自动预取的 log_metadata/log_statistics/timeline/query_events 不再重复发送
#                     （这些数据已在上下文的 metadata/statistics/timeline/events 字段里）
#   · 多轮历史裁剪    首轮发完整上下文，后续轮次改发摘要占位，避免每轮重发整份上下文
#   · 事件证据分档    high/critical 最多 5 条证据，medium 3 条，low 2 条，info 1 条
#   · 记录字段白名单  记录样本只带判定相关字段，派生字段（timestamp_iso）不进上下文
#   · 轻量模式        无事件且覆盖完整时，样本配额降到 60 条、工具轮次收到 1 轮
#   · 缓存友好排序    稳定字段在前、易变字段在后，提升 prompt caching 命中率
#
# Prompt caching（前缀缓存，默认开启）：
#   Anthropic / OpenRouter 等需要显式标记，会自动在 system prompt 上打 cache_control；
#   DeepSeek / OpenAI 走自动前缀缓存，只依赖「稳定内容在前」的排序，不传额外字段。
#   设为 false 可完全关闭（退回纯字符串 content）。
AI_PROMPT_CACHE=true

# 成本估算单价（**故意不内置任何厂商价格**）：
#   价格会变，写死在代码里就会悄悄算出错的成本，而且没人会注意到。
#   所以这里必须由你自己填；留空时台账与报告里的成本显示为 null（不可估算），
#   而不是显示 0 或一个过期的数字。单位是「每百万 token 的金额」，币种由你决定。
#   台账位置：GET /api/analysis/{id}/ai/ledger 的 metrics.cost
# AI_PRICE_INPUT_PER_M=          # 输入（未命中缓存）单价 / 百万 token
# AI_PRICE_OUTPUT_PER_M=         # 输出单价 / 百万 token
# AI_PRICE_CACHE_HIT_PER_M=      # 缓存命中输入单价；不填则按输入单价保守估算

# ---------- 检测规则阈值与开关 ----------
# 留空或删除即使用默认值；规则清单可通过 GET /api/rules 查看。

# SSH / Linux 认证
SSH_FAILURE_THRESHOLD=20
SSH_FAILURE_WINDOW_SECONDS=300
RULE_SSH_BRUTEFORCE_ENABLED=true
RULE_SSH_BRUTEFORCE_SUCCESS_ENABLED=true
RULE_SSH_PRIVILEGED_LOGIN_ENABLED=true

# Web（Nginx / Apache / IIS）
WEB_404_THRESHOLD=20
WEB_404_WINDOW_SECONDS=300
WEB_5XX_THRESHOLD=5
WEB_5XX_WINDOW_SECONDS=300
RULE_WEB_SENSITIVE_PATH_ENABLED=true
RULE_WEB_PATH_TRAVERSAL_ENABLED=true
RULE_WEB_SENSITIVE_FILE_ACCESS_ENABLED=true
RULE_WEB_SENSITIVE_FILE_SUCCESS_ENABLED=true
RULE_WEB_404_SCAN_ENABLED=true
RULE_WEB_5XX_BURST_ENABLED=true
RULE_WEB_SQL_INJECTION_ENABLED=true
RULE_WEB_XSS_ENABLED=true
RULE_WEB_COMMAND_INJECTION_ENABLED=true
RULE_WEB_SENSITIVE_INTERFACE_ENABLED=true
RULE_WEB_WEBSHELL_ENABLED=true
RULE_WEB_SCANNER_USER_AGENT_ENABLED=true
WEB_AUTH_FAILURE_THRESHOLD=4
WEB_AUTH_FAILURE_WINDOW_SECONDS=300
RULE_WEB_AUTH_BRUTEFORCE_ENABLED=true
RULE_WEB_AUTH_BRUTEFORCE_SUCCESS_ENABLED=true

# 应用层安全日志（syslog / 容器日志内层，程序名为 security 的消息）
RULE_APP_SENSITIVE_PATH_PROBE_ENABLED=true
RULE_APP_AUTH_THRESHOLD_BLOCK_ENABLED=true
RULE_APP_RESTRICTED_RESOURCE_ACCESS_ENABLED=true

# Windows Security / RDP
RDP_FAILURE_THRESHOLD=10
RDP_FAILURE_WINDOW_SECONDS=300
RULE_RDP_BRUTEFORCE_ENABLED=true
RULE_RDP_BRUTEFORCE_SUCCESS_ENABLED=true
RULE_WINDOWS_PRIVILEGED_LOGON_ENABLED=true
RULE_WINDOWS_ACCOUNT_LOCKOUT_ENABLED=true
RULE_WINDOWS_SERVICE_INSTALL_ENABLED=true
RULE_WINDOWS_PROTECTION_SERVICE_STOPPED_ENABLED=true

# Windows Sysmon 行为（进程 / 文件 / 注册表 / DNS 事件）
RULE_WINDOWS_LOLBIN_DOWNLOAD_ENABLED=true
RULE_WINDOWS_TEMP_EXECUTION_ENABLED=true
RULE_WINDOWS_ARCHIVE_WITH_PASSWORD_ENABLED=true
RULE_WINDOWS_MASQUERADE_EXTENSION_ENABLED=true
RULE_WINDOWS_CREDENTIAL_FILE_ACCESS_ENABLED=true
RULE_WINDOWS_PAYLOAD_CLEANUP_ENABLED=true
RULE_WINDOWS_REGISTRY_CERT_STORE_ENABLED=true
RULE_WINDOWS_SUSPICIOUS_DNS_ENABLED=true
WINDOWS_DISCOVERY_THRESHOLD=3
WINDOWS_DISCOVERY_WINDOW_SECONDS=300
RULE_WINDOWS_DISCOVERY_COMMAND_ENABLED=true
RULE_WINDOWS_PAYLOAD_OUTBOUND_ENABLED=true
RULE_WINDOWS_EXECUTABLE_DROP_ENABLED=true
RULE_WINDOWS_SCRIPT_INTERPRETER_ENCODED_ENABLED=true
RULE_WINDOWS_COMMAND_SHELL_PARENT_ENABLED=true
WINDOWS_REGISTRY_BULK_THRESHOLD=10
WINDOWS_REGISTRY_BULK_WINDOW_SECONDS=60
RULE_WINDOWS_REGISTRY_BULK_ENABLED=true

# 通用 JSON / CSV 事件
AUTH_FAILURE_THRESHOLD=20
AUTH_FAILURE_WINDOW_SECONDS=300
RULE_AUTH_BRUTEFORCE_ENABLED=true
RULE_AUTH_BRUTEFORCE_SUCCESS_ENABLED=true

# Firewall / WAF 键值日志
FIREWALL_PORT_SCAN_THRESHOLD=10
FIREWALL_PORT_SCAN_WINDOW_SECONDS=300
RULE_FIREWALL_PORT_SCAN_ENABLED=true

# 规则体系：社区 Sigma 规则全局开关（每条导入规则另有独立开关 RULE_<规则名>_ENABLED）
RULE_SIGMA_IMPORTED_ENABLED=true

# 异常评分（借鉴 OWASP CRS）：默认只计算展示，开启后按同源累计分升级风险等级
RISK_SCORING_ENABLED=false
RISK_SCORE_MEDIUM=5
RISK_SCORE_HIGH=10
RISK_SCORE_CRITICAL=15

# 威胁情报富化（默认关闭）：开启后分析中的公网 IP / 域名会被送到外部情报库比对。
# 本地优先工具，外发查询必须由用户显式开启；结果独立展示，不参与风险定级。
THREAT_INTEL_ENABLED=false
# AbuseIPDB 需要 API key（https://www.abuseipdb.com/register）；不配置则自动跳过该来源
# ABUSEIPDB_API_KEY=
THREAT_INTEL_MAX_INDICATORS=15
THREAT_INTEL_REQUEST_TIMEOUT=6
THREAT_INTEL_BUDGET_SECONDS=30
THREAT_INTEL_CACHE_TTL_HOURS=24
THREAT_INTEL_MAX_WORKERS=6
